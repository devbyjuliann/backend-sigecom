NODE_ENV=development
HOST=127.0.0.1
PORT=3001
FRONTEND_ORIGIN=http://127.0.0.1:5173
PUBLIC_APP_ORIGIN=http://127.0.0.1:5173
MAIL_TRANSPORT=simulated
RESEND_API_KEY=
RESEND_FROM=
RESEND_VERIFIED_DOMAIN=
JWT_SECRET=
JWT_ISSUER=sigecom
JWT_AUDIENCE=sigecom-api
JWT_TTL_SECONDS=900
COOKIE_SECURE=false
# Authentication ceilings are process-local; only one Railway backend replica is
# currently configured. Do not enable proxy IP limits until header sanitization
# is proven end to end.
AUTH_LOGIN_ACCOUNT_RATE_LIMIT_MAX=5
AUTH_LOGIN_GLOBAL_RATE_LIMIT_MAX=100
AUTH_PASSWORD_RECOVERY_GLOBAL_RATE_LIMIT_MAX=60
AUTH_PASSWORD_RECOVERY_COMPLETION_GLOBAL_RATE_LIMIT_MAX=60
AUTH_PASSWORD_RECOVERY_COMPLETION_TOKEN_RATE_LIMIT_MAX=10
DB_HOST=127.0.0.1
DB_PORT=3306
XAMPP_ADMIN_USER=
XAMPP_ADMIN_PASSWORD=
SIGECOM_DEV_APP_USER=
SIGECOM_DEV_APP_PASSWORD=
SIGECOM_DEV_MIGRATOR_USER=
SIGECOM_DEV_MIGRATOR_PASSWORD=
SIGECOM_TEST_APP_USER=
SIGECOM_TEST_APP_PASSWORD=
SIGECOM_TEST_MIGRATOR_USER=
SIGECOM_TEST_MIGRATOR_PASSWORD=

# Producción: configurar en el gestor de secretos del entorno autorizado.
# MAIL_TRANSPORT=resend; RESEND_API_KEY debe ser de envío y limitarse al dominio.
# RESEND_FROM debe pertenecer exactamente a RESEND_VERIFIED_DOMAIN.
# PUBLIC_APP_ORIGIN debe ser HTTPS, fijo y también estar en FRONTEND_ORIGIN.
# La API solo recibe PROD_APP; el proceso de migraciones recibe PROD_MIGRATOR.
# Usar NODE_ENV=production, COOKIE_SECURE=true, JWT_ISSUER/AUDIENCE explícitos
# y FRONTEND_ORIGIN HTTPS; nunca cargar contraseñas MIGRATOR en el proceso API.
SIGECOM_PROD_DATABASE=
SIGECOM_PROD_DB_HOST=
SIGECOM_PROD_DB_PORT=
SIGECOM_PROD_DB_TLS_CA_BASE64=
SIGECOM_PROD_APP_USER=
SIGECOM_PROD_APP_PASSWORD=
SIGECOM_PROD_MIGRATOR_USER=
SIGECOM_PROD_MIGRATOR_PASSWORD=
TRUSTED_PROXY_IPS=
