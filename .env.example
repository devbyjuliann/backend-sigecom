NODE_ENV=development
HOST=127.0.0.1
PORT=3001
FRONTEND_ORIGIN=http://127.0.0.1:5173
JWT_SECRET=
JWT_ISSUER=sigecom
JWT_AUDIENCE=sigecom-api
JWT_TTL_SECONDS=900
COOKIE_SECURE=false
AUTH_RATE_LIMIT_MAX=5
DB_HOST=127.0.0.1
DB_PORT=3306
XAMPP_ADMIN_USER=
XAMPP_ADMIN_PASSWORD=
SIGECOM_DEV_APP_USER=
SIGECOM_DEV_APP_PASSWORD=
SIGECOM_DEV_MIGRATOR_USER=
SIGECOM_DEV_MIGRATOR_PASSWORD=
SIGECOM_TEST_APP_USER=
SIGECOM_TEST_APP_PASSWORD=
SIGECOM_TEST_MIGRATOR_USER=
SIGECOM_TEST_MIGRATOR_PASSWORD=

# Producción: configurar en el gestor de secretos del entorno autorizado.
# La API solo recibe PROD_APP; el proceso de migraciones recibe PROD_MIGRATOR.
# Usar NODE_ENV=production, COOKIE_SECURE=true, JWT_ISSUER/AUDIENCE explícitos
# y FRONTEND_ORIGIN HTTPS; nunca cargar contraseñas MIGRATOR en el proceso API.
SIGECOM_PROD_DATABASE=
SIGECOM_PROD_DB_HOST=
SIGECOM_PROD_DB_PORT=
SIGECOM_PROD_DB_TLS_CA_BASE64=
SIGECOM_PROD_APP_USER=
SIGECOM_PROD_APP_PASSWORD=
SIGECOM_PROD_MIGRATOR_USER=
SIGECOM_PROD_MIGRATOR_PASSWORD=
TRUSTED_PROXY_IPS=
